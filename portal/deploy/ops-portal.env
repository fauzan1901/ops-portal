# Ops Portal (read by systemd and by install.sh). Changes: sudo systemctl restart ops-portal
WEB_PORT=8080
WEB_TLS=1
# The DNS name users open; requests to another name (IP, old names) are redirected to it, so Duo SSO always comes back
# to the same host. Switch it with: sudo /opt/ops-portal/deploy/set-hostname.sh <name>
WEB_HOSTNAME=
# Old ONTAP Restore port: redirected to <WEB_HOSTNAME>:<WEB_PORT>/ontap/ (empty = not served)
OLD_ONTAP_PORT=8081
PORTAL_ETC=/etc/ops-portal
PORTAL_DATA=/var/lib/ops-portal
PORTAL_TRUSTED_PROXIES=1
ACI_TEMPLATES_FILE=/etc/ops-portal/product_templates.json
APIC_SESSION_TTL_SECONDS=1800
ONTAP_PLAN_TIMEOUT_SECONDS=300
ONTAP_RESTORE_TIMEOUT_SECONDS=14400
BACKUP_KEEP_DAYS=180
# Operation Automation: an OpenStack fix retypes / migrates volumes one after the other and waits for each
# (default 8 hours for the whole fix).
WI_OPENSTACK_FIX_TIMEOUT_SECONDS=28800
# Operation Automation: web proxy (host:port, HTTP CONNECT) for SSH to PUBLIC addresses when this server has no
# route to the internet (e.g. the Squid of pfSense: 172.26.0.242:3128; Squid must allow CONNECT to port 22).
# Private addresses (10/8, 172.16/12, 192.168/16) are always reached directly. Empty = SSH always direct.
WI_SSH_PROXY=
