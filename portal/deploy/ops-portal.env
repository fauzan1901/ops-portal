# Ops Portal (read by systemd and by install.sh). Changes: sudo systemctl restart ops-portal
WEB_PORT=8480
WEB_TLS=1
# The DNS name users open; requests to another name (IP, old names) are redirected to it, so Duo SSO always comes back
# to the same host. Switch it with: sudo /opt/ops-portal/deploy/set-hostname.sh <name>
WEB_HOSTNAME=
# Old Snapshot Restore port: redirected to <WEB_HOSTNAME>:<WEB_PORT>/restore/ (empty = not served)
OLD_ONTAP_PORT=8481
OPS_ETC=/etc/ops-portal
OPS_DATA=/var/lib/ops-portal
OPS_TRUSTED_PROXIES=1
FABRIC_TEMPLATES_FILE=/etc/ops-portal/product_templates.json
APIC_SESSION_TTL_SECONDS=1800
RESTORE_PLAN_TIMEOUT_SECONDS=300
RESTORE_RESTORE_TIMEOUT_SECONDS=14400
BACKUP_KEEP_DAYS=180
# Runbook Automation: an OpenStack fix retypes / migrates volumes one after the other and waits for each
# (default 8 hours for the whole fix).
RUNBOOK_OPENSTACK_FIX_TIMEOUT_SECONDS=28800
# Runbook Automation: web proxy (host:port, HTTP CONNECT) for SSH to PUBLIC addresses when this server has no
# route to the internet (e.g. the Squid of pfSense: 172.26.32.242:3128; Squid must allow CONNECT to port 22).
# Private addresses (10/8, 172.16/12, 192.168/16) are always reached directly. Empty = SSH always direct.
RUNBOOK_SSH_PROXY=
# Nessus: Tenable Vulnerability Management in the cloud. This server reaches cloud.tenable.com only through the web
# proxy of the bastion (the Squid of pfSense; a direct connection times out). VULNS_PROXY empty = direct. The API keys
# are entered on Administration -> Credentials (target "tenable"), never here.
VULNS_URL=https://cloud.tenable.com
VULNS_PROXY=http://172.26.32.242:3128
