[Unit]
Description=Ops Portal (ACI, ONTAP Restore, Operation Automation)
After=network-online.target
Wants=network-online.target

[Service]
User=opsportal
Group=opsportal
WorkingDirectory=/opt/ops-portal
EnvironmentFile=/etc/ops-portal/ops-portal.env
Environment=HOME=/var/lib/ops-portal PYTHONDONTWRITEBYTECODE=1 PATH=/opt/ops-portal/.venv/bin:/usr/local/bin:/usr/bin:/bin
# One process: sessions and Ansible jobs live in memory.
ExecStart=/opt/ops-portal/.venv/bin/gunicorn --workers 1 --threads 8 --bind 127.0.0.1:18090 --timeout 180 --access-logfile - app:app
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ops-portal
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0027

[Install]
WantedBy=multi-user.target
